ErrorDocument 511 https://www.eliasempresas.com/erros.php?e=511&url=https://%{HTTP_HOST}%{REQUEST_URI}

# -------------------------------
# Segurança Avançada
# -------------------------------
# Bloqueia acesso direto ao .htaccess, .env, arquivos sensíveis
<FilesMatch "(\.htaccess|\.env|\.ini|\.log|\.sh)$">
    Require all denied
</FilesMatch>

# Bloqueia listagem de diretórios
Options -Indexes

# Protege uploads contra execução de scripts
### <Directory "/path/to/uploads">
###     php_flag engine off
### </Directory>

# -------------------------------
# Proteção contra Hotlink
# -------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?eliasempresas\.com/ [NC]
    RewriteRule \.(jpg|jpeg|png|gif|mp4)$ - [F,NC,L]
</IfModule>

# -------------------------------
# Cache básico para performance
# -------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>