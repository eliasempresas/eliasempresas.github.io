# ===========================================
# Elias Empresas - Configuração .htaccess Avançada
# ===========================================

# -------------------------------
# Configurações PHP
# -------------------------------
php_value display_errors On
php_value date.timezone America/Sao_Paulo

# -------------------------------
# Reescrita e HTTPS
# -------------------------------
RewriteEngine On

# Forçar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# -------------------------------
# Tratamento de erros HTTP
# -------------------------------
# 4xx - Cliente
ErrorDocument 400 https://www.eliasempresas.com/erros.php?e=400&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 401 https://www.eliasempresas.com/erros.php?e=401&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 402 https://www.eliasempresas.com/erros.php?e=402&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 403 https://www.eliasempresas.com/erros.php?e=403&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 404 https://www.eliasempresas.com/erros.php?e=404&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 405 https://www.eliasempresas.com/erros.php?e=405&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 406 https://www.eliasempresas.com/erros.php?e=406&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 407 https://www.eliasempresas.com/erros.php?e=407&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 408 https://www.eliasempresas.com/erros.php?e=408&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 409 https://www.eliasempresas.com/erros.php?e=409&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 410 https://www.eliasempresas.com/erros.php?e=410&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 411 https://www.eliasempresas.com/erros.php?e=411&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 412 https://www.eliasempresas.com/erros.php?e=412&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 413 https://www.eliasempresas.com/erros.php?e=413&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 414 https://www.eliasempresas.com/erros.php?e=414&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 415 https://www.eliasempresas.com/erros.php?e=415&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 416 https://www.eliasempresas.com/erros.php?e=416&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 417 https://www.eliasempresas.com/erros.php?e=417&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 418 https://www.eliasempresas.com/erros.php?e=418&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 421 https://www.eliasempresas.com/erros.php?e=421&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 422 https://www.eliasempresas.com/erros.php?e=422&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 423 https://www.eliasempresas.com/erros.php?e=423&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 424 https://www.eliasempresas.com/erros.php?e=424&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 425 https://www.eliasempresas.com/erros.php?e=425&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 426 https://www.eliasempresas.com/erros.php?e=426&url=https://%{HTTP_HOST}%{REQUEST_URI}
