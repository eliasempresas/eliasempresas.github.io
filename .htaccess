# 5xx - Servidor
ErrorDocument 500 https://www.eliasempresas.com/erros.php?e=500&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 501 https://www.eliasempresas.com/erros.php?e=501&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 502 https://www.eliasempresas.com/erros.php?e=502&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 503 https://www.eliasempresas.com/erros.php?e=503&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 504 https://www.eliasempresas.com/erros.php?e=504&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 505 https://www.eliasempresas.com/erros.php?e=505&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 506 https://www.eliasempresas.com/erros.php?e=506&url=https://%{HTTP_HOST}%{REQUEST_URI}
ErrorDocument 507 https://www.eliasempresas.com/erros.php?e=507&url=https://%{HTTP_HOST}%{REQUEST_URI}
